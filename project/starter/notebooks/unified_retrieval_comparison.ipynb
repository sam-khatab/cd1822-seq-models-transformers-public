    "# Visualizing transformer embeddings using PCA\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "import random\n",
    "\n",
    "# Sentence embeddings are not directly reversible back into text.\n",
    "# Use the corpus list to map an embedding back to its original sentence.\n",
    "sentence_index = random.randint(0, transformer_retriever.corpus_embeddings.shape[0] - 1)\n",
    "sentence = transformer_retriever.corpus[sentence_index]\n",
    "sentence_vector = transformer_retriever.corpus_embeddings[sentence_index]\n",
    "print(f\"Selected sentence: {sentence}\")\n",
    "print(f\"Embedding shape: {sentence_vector.shape}\")\n",
    "\n",
    "# Find the nearest sentences in embedding space\n",
    "all_embeddings = transformer_retriever.corpus_embeddings\n",
    "similarities = cosine_similarity([sentence_vector], all_embeddings)[0]\n",
    "top_indices = similarities.argsort()[-11:][::-1]\n",
    "top_indices = [i for i in top_indices if i != sentence_index][:5]\n",
    "similar_sentences = [(transformer_retriever.corpus[i], similarities[i]) for i in top_indices]\n",
    "print(f\"\\nClosest sentences to '{sentence}':\")\n",
    "for text, score in similar_sentences:\n",
    "    print(f\"  ({score:.4f}) {text}\")\n",
    "\n",
    "# Visualize the selected sentence and its nearest neighbors with PCA\n",
    "pca = PCA(n_components=3)\n",
    "neighbor_indices = [sentence_index] + top_indices\n",
    "embedding_3d = pca.fit_transform(all_embeddings[neighbor_indices])\n",
    "\n",
    "fig = plt.figure(figsize=(10, 7))\n",
    "ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "ax.scatter(embedding_3d[0, 0], embedding_3d[0, 1],embedding_3d[0, 2], color='red', label='Selected sentence')\n",
    "ax.text(embedding_3d[0, 0], embedding_3d[0, 1], embedding_3d[0, 2], '  selected')\n",
    "\n",
    "for i in range(1, len(neighbor_indices)):\n",
    "    ax.scatter(embedding_3d[i, 0], embedding_3d[i, 1],embedding_3d[i, 2], color='blue')\n",
    "    ax.text(embedding_3d[i, 0], embedding_3d[i, 1],embedding_3d[i, 2], f'  {i}')\n",
    "\n",
    "ax.set_title('Transformer Sentence Embeddings in 3D Space')\n",
    "ax.set_xlabel('PCA Dimension 1')\n",
    "ax.set_ylabel('PCA Dimension 2')\n",
    "ax.set_zlabel('PCA Dimension 3')\n",
    "plt.show()"
   ]
  },
